{
  "name": "evolumc-launcher",
  "version": "1.0.0",
  "description": "Launcher officiel EvoluMC — EvoluMC_Studios",
  "main": "main.js",
  "author": "EvoluMC_Studios",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build-win": "electron-builder --win --x64"
  },
  "dependencies": {
    "minecraft-launcher-lib": "^6.2.0",
    "msmc": "^4.1.0"
  },
  "devDependencies": {
    "electron": "^29.0.0",
    "electron-builder": "^24.0.0"
  },
  "build": {
    "appId": "fr.evolumc.launcher",
    "productName": "EvoluMC Launcher",
    "copyright": "EvoluMC_Studios © 2024",
    "asar": true,
    "win": {
      "target": "nsis",
      "publisherName": "EvoluMC_Studios"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "EvoluMC Launcher"
    },
    "files": [
      "index.html",
      "main.js",
      "preload.js",
      "node_modules/**/*"
    ]
  }
}
